# Only BOT_TOKEN, DOMAIN and EMAIL must be filled manually.
# setup.sh generates all cryptographic secrets on first run.
BOT_TOKEN=
ENVIRONMENT=production

DOMAIN=your-domain.ru
EMAIL=you@example.com
WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

POSTGRES_DB=aiva
POSTGRES_USER=aiva
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://aiva:generated-by-setup@postgres:5432/aiva
REDIS_URL=redis://redis:6379/0

ENCRYPTION_KEY=
CLIENT_HASH_SALT=
LOG_LEVEL=INFO
DATA_COLLECTION_ENABLED=true
DATA_COLLECTION_LOG_TEXT=false
SUBSCRIPTION_CHECK_INTERVAL=3600
TELEGRAM_PROXY=

YANDEX_FOLDER_ID=
YANDEX_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_FAQ_ENABLED=true
REMINDER_HOURS_BEFORE=24
WINBACK_DAYS=60

DATA_API_ENABLED=false
DATA_API_RATE_LIMIT_DEFAULT=100
BOT_ASSET_FILE_IDS={}
LETSENCRYPT_STAGING=0
