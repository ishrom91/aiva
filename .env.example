BOT_TOKEN=
# Yandex Managed PostgreSQL ТРЕБУЕТ SSL — обязательно ?sslmode=require в конце
DATABASE_URL=postgresql://user:pass@host:6432/db?sslmode=require
REDIS_URL=redis://redis:6379/0
WEBHOOK_URL=                    # опционально; пусто = polling mode (локальная разработка)
ENCRYPTION_KEY=            # сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOG_LEVEL=INFO
CLIENT_HASH_SALT=          # длинная случайная строка, НЕ коммитить реальную
DATA_COLLECTION_ENABLED=true
DATA_COLLECTION_LOG_TEXT=false   # НИКОГДА true в проде
SUBSCRIPTION_CHECK_INTERVAL=3600
TELEGRAM_WEBHOOK_SECRET=   # опционально, для проверки заголовка
TELEGRAM_PROXY=            # опционально: http://user:pass@host:8080 или socks5://...
DATA_API_ENABLED=false
DATA_API_RATE_LIMIT_DEFAULT=100
DOMAIN=your-domain.ru
EMAIL=you@example.com
# Маппинг file_id ассетов бота (заполнить после загрузки картинок в Telegram)
# BOT_ASSET_FILE_IDS={"welcome":"...","booking_ok":"...","reminder":"...","winback":"..."}