# Aiva AI Bot Configuration

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Database Configuration
# NOTE: For Yandex Cloud Managed PostgreSQL, add ?sslmode=require to enable SSL
DATABASE_URL=postgresql+asyncpg://aiva_user:aiva_secret@localhost:5432/aiva_bot?sslmode=require

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Webhook Configuration (optional, leave empty for polling mode)
WEBHOOK_URL=https://yourdomain.com/webhook

# Encryption key (32-character base64-encoded key for Fernet)
ENCRYPTION_KEY=your_32_character_base64_encoded_key_here

# Logging level
LOG_LEVEL=INFO

# Domain configuration for Let's Encrypt
DOMAIN=yourdomain.com
EMAIL=your_email@example.com

# Admin user IDs (comma-separated list of Telegram user IDs)
ADMIN_USER_IDS=123456789,987654321

# Database credentials
DB_USER=aiva_user
DB_PASSWORD=aiva_secret
DB_NAME=aiva_bot

# Anonymization (CRITICAL)
CLIENT_HASH_SALT=aiva_ai_secret_salt_2026_change_this_in_production

# Data Collection (for future Data API)
DATA_COLLECTION_ENABLED=true
DATA_COLLECTION_LOG_TEXT=false  # Don't log actual message text

# Subscription
SUBSCRIPTION_CHECK_INTERVAL=3600  # check limits every hour

# API key for Data API
API_KEY=your_api_key_here